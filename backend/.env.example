SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=your_custom_verify_token_string
META_APP_SECRET=your_meta_app_secret

# SMS — sends the tracking link alongside the WhatsApp receipt, and the
# verification codes for phone sign-in.
# Keep SMS_ENABLED=false until you intend to send to real customers; every send
# is billed per 160-character segment.
# SMS_PROVIDERS is an ordered failover chain — the first provider that accepts
# the message wins, and providers with no credentials are skipped.
# Sender IDs must be telco-approved on the account, max 11 characters.
SMS_ENABLED=false
SMS_PROVIDERS=moolre

MOOLRE_API_URL=https://api.moolre.com/open/sms/send
MOOLRE_VAS_KEY=your_moolre_vas_key
MOOLRE_SENDER_ID=Venariq

# Optional second provider. Add `arkesel` to SMS_PROVIDERS to enable failover.
ARKESEL_API_URL=https://sms.arkesel.com/sms/api
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Veloxa

OWNER_WHATSAPP=233XXXXXXXXX
RESTAURANT_NAME=HallMark Cafe
PUBLIC_WEB_URL=http://localhost:3000
MENU_WEB_APP_URL=http://localhost:3000

# Provisional staff access. Replace with unique strong values before launch.
STAFF_AUTH_SECRET=replace-with-at-least-32-random-characters
STAFF_DEMO_PASSWORD=replace-this-demo-password
STAFF_TOKEN_TTL_MINUTES=720
APP_ENVIRONMENT=development

# Keep false until final hours are confirmed.
ENFORCE_BUSINESS_HOURS=false
RATE_LIMIT_ENABLED=true

# Every browser origin that may call this API. A missing origin fails as a 400
# on the CORS preflight, which the browser reports only as "Failed to fetch".
# 3001 is here because Next dev bumps to it when 3000 is already taken.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-vercel-app.vercel.app
