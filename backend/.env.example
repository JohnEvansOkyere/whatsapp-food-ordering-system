SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_VERIFY_TOKEN=your_custom_verify_token_string
META_APP_SECRET=your_meta_app_secret

# Moolre SMS — sends the tracking link alongside the WhatsApp receipt.
# Keep SMS_ENABLED=false until the Moolre wire format is confirmed against the
# dashboard docs and you intend to send to real customers.
SMS_ENABLED=false
MOOLRE_API_URL=https://api.moolre.com/open/sms/send
MOOLRE_API_USER=your_moolre_api_user
MOOLRE_API_KEY=your_moolre_api_key
MOOLRE_SENDER_ID=VelOxa

OWNER_WHATSAPP=233XXXXXXXXX
RESTAURANT_NAME=Accra Eats
PUBLIC_WEB_URL=http://localhost:3000
MENU_WEB_APP_URL=http://localhost:3000

# Provisional staff access. Replace with unique strong values before launch.
STAFF_AUTH_SECRET=replace-with-at-least-32-random-characters
STAFF_DEMO_PASSWORD=replace-this-demo-password
STAFF_TOKEN_TTL_MINUTES=720
APP_ENVIRONMENT=development

# Keep false until final hours are confirmed.
ENFORCE_BUSINESS_HOURS=false
RATE_LIMIT_ENABLED=true

ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app
